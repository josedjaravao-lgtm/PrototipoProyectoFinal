<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controller.MenuController"
            prefHeight="400.0" prefWidth="600.0">
    <BorderPane>
    <center>
        <VBox alignment="CENTER" prefHeight="547.0" prefWidth="638.0" spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>
            <children>
                <Text   text="Bienvenido al Banco...... (nombre del banco)" >
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
                </Text>
                <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="86.0" prefWidth="266.0" spacing="10.0" style="-fx-background-color: #f0f0f0;" translateX="25.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <Button alignment="CENTER" contentDisplay="CENTER" layoutX="10.0" onAction="#showEntrar" prefHeight="26.0" prefWidth="242.0" text="Entrar" textAlignment="CENTER"
                            style="-fx-background-color:#27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-background-radius: 5;" />
                    <Button alignment="CENTER" contentDisplay="CENTER" onAction="#showSalir" prefHeight="26.0" prefWidth="242.0" text="Salir" textAlignment="CENTER"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-background-radius: 5;"/>
                </VBox>

            </children>
        </VBox>
    </center>
</BorderPane>
</AnchorPane>
